# Gmail SMTP: enable 2-Step Verification and create a Google App Password.
# Put the App Password (not the normal Gmail password) in SMTP_PASS.
# SMTP_FROM should be the same Gmail address as SMTP_USER.
# For Gmail, use either port 465 with SMTP_SECURE=true, or port 587 with false.
SMTP_FROM=
SMTP_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional fallback only when SMTP_HOST and SMTP_URL are both empty.
RESEND_API_KEY=
