# Email OTP for hidden-chat recovery and account authentication
# Render-friendly option: use Resend's HTTPS API rather than SMTP ports.
RESEND_API_KEY=
# Alternatively, set SMTP_URL or the SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS fields.
# SMTP_FROM is required and must be authorized by your provider.
SMTP_FROM=
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
